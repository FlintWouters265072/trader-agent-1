# Alpaca paper trading — generate a key pair at https://app.alpaca.markets/paper/dashboard/overview
# (API Keys panel). These do not expire like Saxo's 24h tokens.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# The trained classifier (train_model.py / ml_decision.py) only ever considers symbols in this
# fixed watchlist — unlike the old LLM path, it needs a known set of symbols to have historical
# data and consistent features for. Comma-separated; leave unset to use the built-in default
# (config.DEFAULT_WATCHLIST). Re-run train_model.py after changing this to bring new symbols online.
WATCHLIST=NVDA,TSLA,MSTR,COIN,SPY,ASML,BTC/USD,ETH/USD,SOL/USD

# Path to the trained model bundle that train_model.py writes and ml_decision.py loads each cycle.
MODEL_PATH=model.joblib

# Hard cap on the dollar size of any single order, enforced regardless of what the model
# requests. Dollar-based (not a share/coin count) since the agent can now pick assets that
# trade at wildly different prices (a stock vs. Bitcoin).
MAX_ORDER_VALUE_USD=1500

# Hard cap on total open exposure (market value) per symbol. Only applies to "buy" decisions —
# selling to close is never blocked, and is separately capped to never exceed what's held (so
# the agent can't accidentally open a short). Once a symbol hits this, buy size is clamped down
# (to 0 if already at or over the cap), which pushes the agent toward other picks instead of
# endlessly concentrating in one.
MAX_SYMBOL_EXPOSURE_USD=15000

# Hard cap on the number of distinct symbols open at once (held position OR an unfilled buy order —
# same "count pending, not just filled" reasoning as the exposure cap above). Adding to a symbol
# already open, and selling/reducing anything held, are never blocked by this.
MAX_CONCURRENT_POSITIONS=8

# All three settings above can also be viewed and edited live from the dashboard's "Risk settings" panel
# (dashboard_server.py). A dashboard edit is saved to risk_overrides.json (gitignored) and takes effect
# on the agent's next ~15-min cycle — no restart or redeploy. An override wins over the value here; use
# the dashboard's "Reset to .env defaults" (or delete risk_overrides.json) to go back to pure .env control.

# Safety switch: agent only logs intended trades until this is "true"
EXECUTE=false
